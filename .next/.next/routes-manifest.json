{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/attendance/[gymSlug]",
      "regex": "^/attendance/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPgymSlug": "nxtPgymSlug"
      },
      "namedRegex": "^/attendance/(?<nxtPgymSlug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/members/[id]",
      "regex": "^/members/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/members/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/attendance",
      "regex": "^/attendance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/attendance(?:/)?$"
    },
    {
